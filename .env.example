# Crie a chave no Google AI Studio e configure-a apenas no ambiente do servidor/Vercel.
GEMINI_API_KEY=

# Opcional: mantenha um modelo estável para produção.
GEMINI_MODEL=gemini-3.1-flash-lite

# Analytics privado do Assistente TR (somente servidor/Vercel).
SUPABASE_ANALYTICS_URL=
SUPABASE_ANALYTICS_SERVICE_ROLE_KEY=
ANALYTICS_ADMIN_PASSWORD=
ANALYTICS_SESSION_SECRET=

# Opcional: Google AdSense Auto Ads. Use apenas o ID aprovado no formato ca-pub-0000000000000000.
VITE_GOOGLE_ADSENSE_CLIENT_ID=
